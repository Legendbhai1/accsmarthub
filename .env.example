# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------------
# Supabase (the live backend: auth, database, storage)
#
# Both are inlined into the browser bundle by Vite, so only the PUBLISHABLE
# (anon) key may go here. Never add a service-role key to a VITE_* variable —
# it would be shipped to every visitor. Privileged work runs in the Edge
# Functions under supabase/functions, which read
# SUPABASE_SERVICE_ROLE_KEY from their own server-side secrets.
#
# The app falls back to the production project when these are unset, so a
# local checkout talks to production by default. Set them to point at a
# staging project instead.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# Migration tooling (scripts/migrate.mjs, scripts/check-schema.mjs).
#
# These are NOT VITE_* and are never bundled; pass them on the command line
# rather than committing them. Listed here for discoverability.
#
#   SUPABASE_PROJECT_REF      the project ref, e.g. fbalfkvimlfmcpsfzrvn
#   SUPABASE_ACCESS_TOKEN     a Management API token (sbp_…)
#   SUPABASE_DB_PASSWORD      only for the direct-psql migration path
# ---------------------------------------------------------------------
